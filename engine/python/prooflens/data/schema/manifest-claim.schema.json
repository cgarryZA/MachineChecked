{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cgarryZA/ProofLens/schema/manifest-claim.schema.json",
  "title": "ProofLens claim passport",
  "type": "object",
  "required": [
    "schema",
    "release",
    "id",
    "paper",
    "status",
    "clauses",
    "findings",
    "decls",
    "status_code",
    "source_evidence"
  ],
  "properties": {
    "schema": {
      "const": "prooflens/manifest@1"
    },
    "release": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "statement_tex": {
      "type": [
        "string",
        "null"
      ]
    },
    "excerpt": {
      "description": "Display only: the passage the reader typesets from the pinned LaTeX source, or the reasons it cannot (docs/SOURCE_REGIONS.md). Its fingerprint is separate from source_sha256.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "scheme",
        "ready",
        "reasons",
        "fingerprint"
      ],
      "properties": {
        "scheme": {
          "const": "tex-excerpt-v1"
        },
        "ready": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocks": {
          "type": [
            "array",
            "null"
          ]
        },
        "macros": {
          "type": "object"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "state",
          "evidence"
        ],
        "properties": {
          "state": {
            "enum": [
              "unspecified",
              "unchecked",
              "open",
              "proved",
              "refuted",
              "malformed",
              "stated"
            ]
          },
          "evidence": {
            "type": "object",
            "required": [
              "formal",
              "review",
              "replay",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "formal": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "proved",
                      "refuted",
                      "open",
                      "unspecified",
                      "unchecked",
                      "stated",
                      "malformed"
                    ]
                  }
                }
              },
              "review": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "reviewed",
                      "author-reviewed",
                      "pending",
                      "stale",
                      "unknown"
                    ]
                  }
                }
              },
              "replay": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "not-run",
                      "unverified"
                    ]
                  },
                  "guard": {
                    "enum": [
                      "guarded",
                      "unguarded",
                      "unrecorded"
                    ]
                  }
                }
              },
              "source": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail",
                      "none",
                      "open",
                      "pdf-only"
                    ]
                  }
                }
              },
              "locked-statement": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail",
                      "none",
                      "open",
                      "n/a"
                    ]
                  }
                }
              },
              "exact-statement": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail",
                      "none",
                      "open",
                      "n/a"
                    ]
                  }
                }
              },
              "axioms": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail",
                      "none",
                      "open",
                      "n/a"
                    ]
                  }
                }
              },
              "witness": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail",
                      "none",
                      "open",
                      "n/a"
                    ]
                  }
                }
              },
              "regimes": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail",
                      "none",
                      "open",
                      "n/a"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decls": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{24}$"
      },
      "description": "Each declaration of the claim's closures, by name, with the key of its record data/decls/<key>.json (the first 24 hex digits of the SHA-256 of the record)"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status_code": {
      "type": "string",
      "enum": [
        "unknown",
        "formal.accepted",
        "formal.author-reviewed",
        "formal.review-pending",
        "formal.open",
        "formal.unspecified",
        "formal.malformed",
        "formal.unchecked",
        "definition.unchecked",
        "definition.unstated",
        "definition.review-pending",
        "definition.author-reviewed",
        "definition.reviewed",
        "link.missing",
        "link.definition",
        "link.incomplete",
        "link.axioms",
        "link.checked",
        "link.unbuilt",
        "link.module-unbuilt",
        "link.module-failed",
        "link.ambiguous",
        "link.no-audit",
        "link.not-in-audit",
        "link.suggested",
        "link.none",
        "formal.refuted",
        "formal.refuted.open",
        "formal.refuted.corrected",
        "formal.refuted.corrected.open",
        "scope.expository",
        "scope.literature",
        "scope.empirical",
        "scope.proof-step",
        "scope.part-of",
        "scope.duplicate",
        "link.claim-audit",
        "audit.unavailable",
        "audit.incompatible"
      ]
    },
    "source_evidence": {
      "type": "object",
      "required": [
        "state",
        "placement"
      ]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "tier",
        "code",
        "subject",
        "message"
      ],
      "properties": {
        "tier": {
          "enum": [
            "violation",
            "warning",
            "obligation"
          ]
        }
      }
    }
  }
}
