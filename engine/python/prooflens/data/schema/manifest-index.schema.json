{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cgarryZA/ProofLens/schema/manifest-index.schema.json",
  "title": "ProofLens manifest index",
  "type": "object",
  "required": [
    "schema",
    "release",
    "evidence",
    "papers",
    "claims",
    "summary",
    "classes",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "prooflens/manifest@1"
    },
    "release": {
      "type": "string"
    },
    "evidence": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created": {
      "type": "string"
    },
    "project": {
      "type": "object"
    },
    "lean": {
      "type": [
        "object",
        "null"
      ]
    },
    "tool": {
      "type": "object"
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "pdf"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "latex",
              "pdf"
            ]
          },
          "pdf": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "findings": {
      "type": "object"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "paper",
          "status",
          "class",
          "file",
          "counts",
          "status_code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "paper": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "class": {
            "enum": [
              "accepted",
              "proved",
              "refuted",
              "open",
              "malformed",
              "out-of-scope",
              "unspecified",
              "declared"
            ]
          },
          "anchor": {
            "type": [
              "object",
              "null"
            ]
          },
          "file": {
            "type": "string"
          },
          "counts": {
            "type": "object"
          },
          "status_code": {
            "type": "string",
            "enum": [
              "unknown",
              "formal.accepted",
              "formal.author-reviewed",
              "formal.review-pending",
              "formal.open",
              "formal.unspecified",
              "formal.malformed",
              "formal.unchecked",
              "definition.unchecked",
              "definition.unstated",
              "definition.review-pending",
              "definition.author-reviewed",
              "definition.reviewed",
              "link.missing",
              "link.definition",
              "link.incomplete",
              "link.axioms",
              "link.checked",
              "link.unbuilt",
              "link.module-unbuilt",
              "link.module-failed",
              "link.ambiguous",
              "link.no-audit",
              "link.not-in-audit",
              "link.suggested",
              "link.none",
              "formal.refuted",
              "formal.refuted.open",
              "formal.refuted.corrected",
              "formal.refuted.corrected.open",
              "scope.expository",
              "scope.literature",
              "scope.empirical",
              "scope.proof-step",
              "scope.part-of",
              "scope.duplicate",
              "link.claim-audit",
              "audit.unavailable",
              "audit.incompatible"
            ]
          }
        }
      }
    },
    "search": {
      "type": "string"
    },
    "uses": {
      "type": "string",
      "description": "The reverse references of the project's declarations (data/uses.json)."
    }
  }
}
