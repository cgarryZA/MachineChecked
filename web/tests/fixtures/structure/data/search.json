{"claims": [{"heading": null, "id": "P:thm:layout", "lean": ["Shape.layout"], "number": "Theorem 1", "paper": "P", "statement": "\\label{thm:layout}\\lean{Shape.layout} Let $E$ be a nonempty type and $1 \\le j \\le k$. For every $x$ there is a constant $C$ such that, for every $n$, both $x \\le C$ and $n + x \\le n + C$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:witnesses", "lean": ["Shape.witnesses"], "number": "Theorem 2", "paper": "P", "statement": "\\label{thm:witnesses}\\lean{Shape.witnesses} For every $j$ there is a function $x$ with $x(j) = j$ and $j \\le x(j)$, and there is a boolean $x$ that is true.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:shapes", "lean": ["Shape.shapes"], "number": "Theorem 3", "paper": "P", "statement": "\\label{thm:shapes}\\lean{Shape.shapes} Let $E$ be nonempty. No natural number is negative, and either every $n$ satisfies $0 \\le n$ or, if $1 = 1$, some $m$ equals $1$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:def:multiple", "lean": ["Shape.MultipleAbove", "Shape.fib"], "number": "Definition 1", "paper": "P", "statement": "\\label{def:multiple}\\lean{Shape.MultipleAbove}\\lean{Shape.fib} A number $n$ is a multiple of $m$ above $b$ if $n = mq$ for some $q \\ge b$. The Fibonacci numbers are $F_0 = 0$, $F_1 = 1$ and $F_{n+2} = F_n + F_{n+1}$.", "status": "linked: Lean definition", "status_code": "link.definition", "title": ""}, {"heading": null, "id": "P:thm:supplied", "lean": ["Shape.supplied"], "number": "Theorem 4", "paper": "P", "statement": "\\label{thm:supplied}\\lean{Shape.supplied} Let $s$ be a solution for $d$ with bound at most $5$. Then $s$ starts at most at $5$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:assumed", "lean": ["Shape.assumed"], "number": "Theorem 5", "paper": "P", "statement": "\\label{thm:assumed}\\lean{Shape.assumed} If every admissible datum has a good solution, then $0$ has a good solution.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:produced", "lean": ["Shape.produced"], "number": "Theorem 6", "paper": "P", "statement": "\\label{thm:produced}\\lean{Shape.produced} Every admissible datum $d$ has a good solution.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:positive", "lean": ["Shape.positive"], "number": "Theorem 7", "paper": "P", "statement": "\\label{thm:positive}\\lean{Shape.positive} Every positive number is at least $1$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:single", "lean": ["Shape.single"], "number": "Theorem 8", "paper": "P", "statement": "\\label{thm:single}\\lean{Shape.single} A type with a single element has at most one element, and exactly one.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:probability", "lean": ["Shape.probability"], "number": "Theorem 9", "paper": "P", "statement": "\\label{thm:probability}\\lean{Shape.probability} On a probability space, the whole space has measure one.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:none-large", "lean": ["Shape.none_large"], "number": "Theorem 10", "paper": "P", "statement": "\\label{thm:none-large}\\lean{Shape.none_large} No solution for $0$ has a negative bound.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:two-solutions", "lean": ["Shape.two_solutions"], "number": "Theorem 11", "paper": "P", "statement": "\\label{thm:two-solutions}\\lean{Shape.two_solutions} Two solutions $s$ and $t$ for the same datum start at the same point.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:both", "lean": ["Shape.both"], "number": "Theorem 12", "paper": "P", "statement": "\\label{thm:both}\\lean{Shape.both} If $a \\le b$ and $b \\le a$, then $a = b$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:def:profile", "lean": ["Shape.Profile", "Shape.Concrete"], "number": "Definition 2", "paper": "P", "statement": "\\label{def:profile}\\lean{Shape.Profile}\\lean{Shape.Concrete} A profile is a function $f$ with $f(n) \\le C$ for every $n$. A concrete profile is a profile that vanishes from $N$ on and has period $p$ below $N$.", "status": "linked: Lean definition", "status_code": "link.definition", "title": ""}, {"heading": null, "id": "P:thm:build", "lean": ["Shape.build", "Shape.build_rec"], "number": "Theorem 13", "paper": "P", "statement": "\\label{thm:build}\\lean{Shape.build}\\lean{Shape.build_rec} The zero profile below $N$ is a concrete profile, and $f(n + 1) = f(n)$ for it.", "status": "linked: Lean definition", "status_code": "link.definition", "title": ""}, {"heading": null, "id": "P:thm:vanishes", "lean": ["Shape.vanishes"], "number": "Theorem 14", "paper": "P", "statement": "\\label{thm:vanishes}\\lean{Shape.vanishes} A concrete profile vanishes from $N$ on.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:scaled", "lean": ["Shape.scaled"], "number": "Theorem 15", "paper": "P", "statement": "\\label{thm:scaled}\\lean{Shape.scaled} A scaled family for $d$ and $w$ that starts at $d$ starts at $d$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:both-pos", "lean": ["Shape.both_pos"], "number": "Theorem 16", "paper": "P", "statement": "\\label{thm:both-pos}\\lean{Shape.both_pos} An object with both extents has a positive first coordinate.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:jet", "lean": ["Shape.jet_lower"], "number": "Theorem 17", "paper": "P", "statement": "\\label{thm:jet}\\lean{Shape.jet_lower} If the first $n + 5$ differences of $f$ are bounded by $C$ on $S$, so are the first $n + 4$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:below", "lean": ["Shape.below_succ", "Shape.every_below"], "number": "Theorem 18", "paper": "P", "statement": "\\label{thm:below}\\lean{Shape.below_succ}\\lean{Shape.every_below} A vector bounded by $i$ is bounded by $i + 1$; vectors bounded by $7$ are bounded by $8$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:steps", "lean": ["Shape.steps_pos", "Shape.pick_at"], "number": "Theorem 19", "paper": "P", "statement": "\\label{thm:steps}\\lean{Shape.steps_pos}\\lean{Shape.pick_at} The number of steps down from $k + 3$ is positive, and $\\mathrm{pick}(k + 1, 0) = 1$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:conditional", "lean": ["Shape.conditional"], "number": "Theorem 20", "paper": "P", "statement": "\\label{thm:conditional}\\lean{Shape.conditional} If every $x$ with $A(x)$ has some $y$ with $B(x, y)$, and $A(a)$ holds, then some $y$ has $B(a, y)$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:alternating", "lean": ["Shape.alternating"], "number": "Theorem 21", "paper": "P", "statement": "\\label{thm:alternating}\\lean{Shape.alternating} For every $x$ there is $y$ such that $x + z \\le y + z$ for every $z$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:premised", "lean": ["Shape.premised"], "number": "Theorem 22", "paper": "P", "statement": "\\label{thm:premised}\\lean{Shape.premised} If $P$ holds, some $x$ is $0$; $Q$ holds exactly when some $n$ equals itself; and either some $x$ is $1$ or $Q$ holds.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:one-map", "lean": ["Shape.one_map"], "number": "Theorem 23", "paper": "P", "statement": "\\label{thm:one-map}\\lean{Shape.one_map} Some map $\\Phi \\colon G \\to H$ over $\\mathbb{N}$ has both $A$ and $B$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:bound-once", "lean": ["Shape.bound_once", "Shape.bound_each"], "number": "Theorem 24", "paper": "P", "statement": "\\label{thm:bound-once}\\lean{Shape.bound_once}\\lean{Shape.bound_each} There is a constant $C$ with $n \\le C n^2 + n$ for every $n$; and for every $n$ there is such a constant.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:isometry", "lean": ["Shape.isometry_classes"], "number": "Theorem 25", "paper": "P", "statement": "\\label{thm:isometry}\\lean{Shape.isometry_classes} Let $\\mu$ and $\\nu$ be $\\sigma$-finite measures and $\\Phi \\colon L^2(\\mu \\otimes \\nu) \\to \\mathbb{R}^3$ a linear isometry. Every class $F$ has a representative, unique almost everywhere.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:alternatives", "lean": ["Shape.alternatives"], "number": "Theorem 26", "paper": "P", "statement": "\\label{thm:alternatives}\\lean{Shape.alternatives} If $m \\le b$ for every $m \\le n$, then some real $x$ exceeds $n$, or $n = 2x$ for some $x$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:def:digit", "lean": ["Shape.Digit.val"], "number": "Definition 3", "paper": "P", "statement": "\\label{def:digit}\\lean{Shape.Digit.val} The value of the digit $d_i$ is $i$, for $i = 0, \\dots, 69$.", "status": "linked: Lean definition", "status_code": "link.definition", "title": ""}, {"heading": null, "id": "P:thm:digit", "lean": ["Shape.last_digit"], "number": "Theorem 27", "paper": "P", "statement": "\\label{thm:digit}\\lean{Shape.last_digit} The value of the digit $d_{69}$ is $69$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:digit-index", "lean": ["Shape.last_index"], "number": "Theorem 28", "paper": "P", "statement": "\\label{thm:digit-index}\\lean{Shape.last_index} A digit whose constructor index is $69$ has the value $69$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:margin", "lean": ["Shape.margin_half"], "number": "Theorem 29", "paper": "P", "statement": "\\label{thm:margin}\\lean{Shape.margin_half} Half of $k + 2$ is less than $k + 2 + k$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:def:jets", "lean": ["Shape.SpaceJet", "Shape.TimeJet", "Shape.FullJet", "Shape.supSpace", "Shape.supTime"], "number": "Definition 4", "paper": "P", "statement": "\\label{def:jets}\\lean{Shape.SpaceJet}\\lean{Shape.TimeJet}\\lean{Shape.FullJet}\\lean{Shape.supSpace}\\lean{Shape.supTime} Let $D_{a,b}(t, x)$ be the derivative $\\partial_t^a \\partial_x^b u$ at time $t$ and point $x$. Then $J_x(D, k, C)$ says that $D_{0,b} \\le C$ for every $b \\le k$ (derivatives in space), $J_t(D, k, C)$ that $D_{a,0} \\le C$ for every $a \\le k$ (derivatives in time), and $J(D, k, C)$ that $D_{a,b} \\le C$ for every $a + b \\le k$ (all variables). The norm in space $M_x(u, t, N)$ is the largest $u(t, x)$ over $x \\le N$, and the norm in time $M_t(u, x, N)$ the largest $u(s, x)$ over $s \\le N$.", "status": "linked: Lean definition", "status_code": "link.definition", "title": ""}, {"heading": null, "id": "P:thm:jets", "lean": ["Shape.full_jet_split"], "number": "Theorem 30", "paper": "P", "statement": "\\label{thm:jets}\\lean{Shape.full_jet_split} If $J(D, k, C)$, then $J_x(D, k, C)$ and $J_t(D, k, C)$.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}, {"heading": null, "id": "P:thm:norms", "lean": ["Shape.norm_bounds"], "number": "Theorem 31", "paper": "P", "statement": "\\label{thm:norms}\\lean{Shape.norm_bounds} If $M_x(u, t, N) \\le C$ and $M_t(u, x, N) \\le C$, then both bounds hold.", "status": "linked: Lean proof checked", "status_code": "link.checked", "title": ""}], "decls": [{"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "DFunLike"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "DFunLike.coe"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "DFunLike.mk"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "ENNReal"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "ENNReal.mk"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "ENNReal.val"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "EuclideanSpace"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "EuclideanSpace.coords"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "EuclideanSpace.mk"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "Filter"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "Filter.Eventually"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "Filter.Eventually.intro"}, {"claims": ["P:thm:probability", "P:thm:isometry", "P:thm:alternatives"], "name": "Filter.EventuallyEq"}, {"claims": ["P:thm:probability